# Copy to .env and fill in.

# Supabase Postgres. DATABASE_URL = pooled connection (Transaction pooler,
# port 6543) with pgbouncer; DIRECT_URL = direct connection (port 5432).
# From Supabase: Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# WhatsApp Business Cloud API. Keep WHATSAPP_ENABLED=false to run in STUB mode
# (messages composed + logged, never sent). Set to true and fill the rest to go live.
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Verify token you choose when registering the webhook in the Meta dashboard
# (used by /api/whatsapp/webhook to catch customers' "yes" reschedule replies).
WHATSAPP_VERIFY_TOKEN=""

# Shared secret protecting the cron endpoints (/api/cron/*).
CRON_SECRET=""

# Public base URL used in links inside messages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
