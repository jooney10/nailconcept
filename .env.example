# Copy to .env and fill in.

# Local dev: SQLite (zero setup). Production: Supabase Postgres connection string,
# and change datasource provider to "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# WhatsApp Business Cloud API. Keep WHATSAPP_ENABLED=false to run in STUB mode
# (messages composed + logged, never sent). Set to true and fill the rest to go live.
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# Shared secret protecting the cron endpoints (/api/cron/*).
CRON_SECRET=""

# Public base URL used in links inside messages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
